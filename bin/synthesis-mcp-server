#!/usr/bin/env bash
#
# Synthesis MCP Server Launcher
# Launches the Synthesis MCP (Model Context Protocol) server for AI agent integration.
#
# This server exposes Synthesis search/relate/graph/stats capabilities over
# JSON-RPC 2.0 on stdio, compliant with the MCP specification.
#
# Usage:
#   synthesis-mcp-server                          # Start with current directory as workspace
#   synthesis-mcp-server --workspace ~/project    # Start with specific workspace
#   synthesis-mcp-server --version                # Show version
#
# Claude Code Integration (~/.claude/config.json):
#   {
#     "mcpServers": {
#       "synthesis": {
#         "command": "synthesis-mcp-server",
#         "args": ["--workspace", "/path/to/project"]
#       }
#     }
#   }
#
# Environment:
#   SYNTHESIS_HOME              Installation directory (default: ~/.synthesis)
#   SYNTHESIS_JAVA_OPTS         Extra JVM options (e.g., "-Xmx2g")
#
# Copyright (c) 2026 eXOReaction AS. All rights reserved.

set -euo pipefail

readonly SYNTHESIS_HOME="${SYNTHESIS_HOME:-$HOME/.synthesis}"
readonly JAR_NAME="synthesis-mcp-server.jar"
readonly JAR_PATH="$SYNTHESIS_HOME/lib/$JAR_NAME"
readonly MIN_JAVA_VERSION=21

# ---------------------------------------------------------------------------
# Pre-flight Checks (output to stderr, not stdout -- stdout is for JSON-RPC)
# ---------------------------------------------------------------------------

# Check JAR exists
if [ ! -f "$JAR_PATH" ]; then
    # Try local development path
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    DEV_JAR="$SCRIPT_DIR/../target/$JAR_NAME"
    if [ -f "$DEV_JAR" ]; then
        JAR_TO_USE="$DEV_JAR"
    else
        echo "Error: Synthesis MCP Server JAR not found at $JAR_PATH" >&2
        echo "  Run: mvn package -DskipTests" >&2
        echo "  Or: bin/install.sh" >&2
        exit 1
    fi
else
    JAR_TO_USE="$JAR_PATH"
fi

# Check Java exists
if ! command -v java >/dev/null 2>&1; then
    echo "Error: Java not found. Java ${MIN_JAVA_VERSION}+ is required." >&2
    exit 1
fi

# Check Java version
JAVA_VER=$(java -version 2>&1 | head -1 | sed -n 's/.*version "\([0-9]*\).*/\1/p')
JAVA_VER="${JAVA_VER:-0}"
if [ "$JAVA_VER" -lt "$MIN_JAVA_VERSION" ]; then
    echo "Error: Java $JAVA_VER found, but Java ${MIN_JAVA_VERSION}+ is required." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Launch MCP Server
# ---------------------------------------------------------------------------

# JVM flags to suppress warnings (can be overridden via SYNTHESIS_JAVA_OPTS)
DEFAULT_JAVA_OPTS="--enable-native-access=ALL-UNNAMED -Djava.util.logging.config.file=/dev/null"
JAVA_OPTS="${SYNTHESIS_JAVA_OPTS:-$DEFAULT_JAVA_OPTS}"

exec java $JAVA_OPTS -jar "$JAR_TO_USE" "$@"
